  10   1          TH1 = 0xFA;   // 设定定时器重装值
  11   1          ET1 = 0;      // 禁止定时器1中断
  12   1          TR1 = 1;      // 启动定时器1
  13   1          ES = 1;
  14   1          EA = 1;
  15   1      }
  16          
  17          void UartSend(unsigned char Byte)
  18          {
  19   1          SBUF = Byte;
  20   1          while (TI == 0);
  21   1          TI = 0;
  22   1      }
